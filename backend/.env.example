# =============================================================================
# foody-tracking-api — environment variables
#
#   cp .env.example .env
#
# Ready to use as-is for local runs (./mvnw spring-boot:run) and Docker
# (docker compose up). Plain KEY=value lines only: Spring imports this file as
# properties, so no quotes and no `export`.
#
# EVALUATION VALUES: the JWT secret and the admin pair below are public (they
# are the dev-profile defaults). For a real deployment generate a new secret
# (openssl rand -base64 48) and choose another admin password.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# dev | prod. The Docker image always runs prod, whatever this says.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Application zone: drives the clock and every date in the JSON (-03:00).
APP_TIME_ZONE=America/Sao_Paulo
# Log timestamps inside Docker; keep it equal to APP_TIME_ZONE.
TZ=America/Sao_Paulo

# --- Database ----------------------------------------------------------------
# SQLite file, created on first start; Flyway applies the migrations.
SPRING_DATASOURCE_URL=jdbc:sqlite:./data/foody.db?journal_mode=WAL&busy_timeout=5000&foreign_keys=true

# --- Web ---------------------------------------------------------------------
# Comma-separated. Vite dev server (5173) and vite preview (4173).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Security ----------------------------------------------------------------
# HS256 key, Base64, at least 32 bytes.
APP_SECURITY_JWT_SECRET=6TxraCkFf6oRqgAdVNPUN2zbIVvQziInuKzha8i288LD8pPNB9SpaLEY7FqRHSPf
# Single ADMIN created at startup (set both or neither). Password: 8+ chars.
APP_SECURITY_ADMIN_EMAIL=admin@foody.local
APP_SECURITY_ADMIN_PASSWORD=admin-dev-password
# Demo password reset without e-mail confirmation; false removes the route.
APP_SECURITY_PASSWORD_RESET_ENABLED=true
