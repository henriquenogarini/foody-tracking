# ---------------------------------------------------------------------------
# foody-tracking-api — environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Loaded by Spring Boot through `spring.config.import=optional:file:.env[.properties]`
# in application.yml, so plain KEY=value lines only (no quotes, no `export`).
# Docker (`--env-file .env`) and IDE run configurations can load the same file.
# ---------------------------------------------------------------------------

# Active Spring profile: dev | test | postgres
SPRING_PROFILES_ACTIVE=dev

# HTTP port
SERVER_PORT=8080

# SQLite datasource. Relative paths resolve from the working directory.
# WAL journal + busy_timeout are required (single-writer database, pool size 1).
SPRING_DATASOURCE_URL=jdbc:sqlite:./data/foody.db?journal_mode=WAL&busy_timeout=5000&foreign_keys=true

# JWT HMAC-SHA256 secret: Base64, at least 32 bytes (256 bits).
# Generate one with: openssl rand -base64 48
APP_SECURITY_JWT_SECRET=

# CORS allowed origins (comma-separated). Default is the local frontend.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
