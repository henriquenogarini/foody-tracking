# ---------------------------------------------------------------------------
# foody-tracking-api — environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Loaded by Spring Boot through `spring.config.import=optional:file:.env[.properties]`
# in application.yml, so plain KEY=value lines only (no quotes, no `export`).
# Docker (`--env-file .env`) and IDE run configurations can load the same file.
# ---------------------------------------------------------------------------

# Active Spring profile: dev | prod (test is test-only; the Docker image always forces prod,
# because dev ships public dev secrets)
SPRING_PROFILES_ACTIVE=dev

# HTTP port
SERVER_PORT=8080

# SQLite datasource. Relative paths resolve from the working directory.
# WAL journal + busy_timeout are required (single-writer database, pool size 1).
SPRING_DATASOURCE_URL=jdbc:sqlite:./data/foody.db?journal_mode=WAL&busy_timeout=5000&foreign_keys=true

# Secrets stay commented out: a blank line in .env overrides the dev profile defaults (an empty
# JWT secret fails startup; a blank admin pair disables the dev admin). In dev leave them
# commented; outside dev (prod, Docker) uncomment and set them — prod requires the JWT secret.

# JWT HMAC-SHA256 secret: Base64, at least 32 bytes (256 bits).
# Generate one with: openssl rand -base64 48
# APP_SECURITY_JWT_SECRET=

# Optional single bootstrap ADMIN, created once at startup. Set both or neither (only one fails
# startup); blank counts as absent. Password: 8+ characters, at most 72 bytes.
# An e-mail that already belongs to a USER is never promoted.
# APP_SECURITY_ADMIN_EMAIL=
# APP_SECURITY_ADMIN_PASSWORD=

# Demo password reset (POST /api/v1/auth/password-reset, no e-mail confirmation). Enabled by
# default; set to false to remove the route (it then answers 404).
# APP_SECURITY_PASSWORD_RESET_ENABLED=

# CORS allowed origins (comma-separated). Default is the local frontend.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Application zone (zone id, never a fixed offset): drives the Clock and the JSON dates.
APP_TIME_ZONE=America/Sao_Paulo

# Container zone used by log timestamps; keep the same value as APP_TIME_ZONE. Only effective
# when the file is passed to Docker (`--env-file` / compose `env_file`): Spring reads `.env` as
# properties, so it does NOT change the JVM zone of IDE or `./mvnw` runs. For those, start the
# JVM with -Duser.timezone=America/Sao_Paulo.
TZ=America/Sao_Paulo
